#pragma once

#include <compare>
#include <cstdint>
#include <string_view>

namespace realm::config
{

struct Version
{
public:
    constexpr Version() noexcept = default;
    constexpr explicit Version(std::uint64_t packed) noexcept
        : _packed{ packed }
    {}

    constexpr explicit Version(std::uint8_t major, std::uint8_t minor, std::uint16_t patch, std::uint32_t commit) noexcept
        : _packed{ pack(major, minor, patch, commit) }
    {}

public:
    static constexpr std::uint64_t pack(std::uint8_t major, std::uint8_t minor, std::uint16_t patch, std::uint32_t commit) noexcept
    {
        return (static_cast<std::uint64_t>(commit) << 0)  |
               (static_cast<std::uint64_t>(patch)  << 32) |
               (static_cast<std::uint64_t>(minor)  << 48) |
               (static_cast<std::uint64_t>(major)  << 56);
    }

public:
    constexpr std::uint64_t packed() const noexcept { return _packed; }
    constexpr std::uint8_t  major() const noexcept { return static_cast<std::uint8_t>(_packed >> 56); }
    constexpr std::uint8_t  minor() const noexcept { return static_cast<std::uint8_t>(_packed >> 48); }
    constexpr std::uint16_t patch() const noexcept { return static_cast<std::uint16_t>(_packed >> 32); }
    constexpr std::uint32_t commit() const noexcept { return static_cast<std::uint32_t>(_packed >> 0); }

public:
    friend constexpr auto operator<=>(Version, Version) noexcept = default;
    friend constexpr bool operator==(Version, Version) noexcept  = default;

private:
    std::uint64_t _packed{0};
};

// Pre-release tag ("dev", "rc1", ...), or empty when there is none.
inline constexpr std::string_view k_version_sub = "${VERSION_SUB}";

// human-readable string
inline constexpr std::string_view k_version_str = k_version_sub.empty()
    ? "${VERSION_MAJOR}.${VERSION_MINOR}.${VERSION_ALTER}-${GIT_COMMIT}"
    : "${VERSION_MAJOR}.${VERSION_MINOR}.${VERSION_ALTER}-${VERSION_SUB}-${GIT_COMMIT}";

}