#pragma once

#include <realm/base/common/typedefs.hpp>
#include <realm/base/common/defines.hpp>

#include <compare>
#include <cstdint>
#include <string_view>

namespace realm::version
{

struct Version
{
public:
    constexpr Version() noexcept = default;
    constexpr explicit Version(u64 packed) noexcept
        : _packed{ packed }
    {}

    constexpr explicit Version(u8 major, u8 minor, u16 patch, u32 commit) noexcept
        : _packed{ pack(major, minor, patch, commit) }
    {}

public:
    RE_FORCE_INLINE static constexpr u64 pack(u8 major, u8 minor, u16 patch, u32 commit) noexcept
    {
        return (static_cast<u64>(commit) << 0)  |
               (static_cast<u64>(patch)  << 32) |
               (static_cast<u64>(minor)  << 48) |
               (static_cast<u64>(major)  << 56);
    }

public:
    RE_FORCE_INLINE constexpr u64 packed() const noexcept { return _packed; }
    RE_FORCE_INLINE constexpr u8  major() const noexcept { return static_cast<u8>(_packed >> 56); }
    RE_FORCE_INLINE constexpr u8  minor() const noexcept { return static_cast<u8>(_packed >> 48); }
    RE_FORCE_INLINE constexpr u16 patch() const noexcept { return static_cast<u16>(_packed >> 32); }
    RE_FORCE_INLINE constexpr u32 commit() const noexcept { return static_cast<u32>(_packed >> 0); }

public:
    friend constexpr auto operator<=>(Version, Version) noexcept = default;
    friend constexpr bool operator==(Version, Version) noexcept  = default;

private:
    u64 _packed{0};
};

inline constexpr Version k_version = Version{ static_cast<u8>(${VERSION_MAJOR}),
                                              static_cast<u8>(${VERSION_MINOR}),
                                              static_cast<u16>(${VERSION_ALTER}),
                                              static_cast<u32>(0x${GIT_COMMIT}) };

// Pre-release tag ("dev", "rc1", ...), or empty when there is none.
inline constexpr std::string_view k_version_sub = "${VERSION_SUB}";

// human-readable version string
inline constexpr std::string_view k_version_str = k_version_sub.empty()
    ? "${VERSION_MAJOR}.${VERSION_MINOR}.${VERSION_ALTER}-${GIT_COMMIT}"
    : "${VERSION_MAJOR}.${VERSION_MINOR}.${VERSION_ALTER}-${VERSION_SUB}-${GIT_COMMIT}";

}